generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  ADMIN
  USER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  PERMISSION
}

enum WorkMode {
  ONSITE
  WFH
  WFA
}

enum PermissionType {
  WFH
  WFA
}

//
// USER
//

model User {
  id            String   @id @default(uuid())
  nama          String
  email         String   @unique
  password      String
  photo         String?
  role          Role     @default(USER)

  joinDate      DateTime
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances   Attendance[]
  permissions   WorkPermission[]
  approvedPermissions WorkPermission[] @relation("ApprovedBy")
  geofenceLogs  GeofenceLog[]
  taskProgress  UserTaskProgress[]
  summaries     WeeklySummary[]

  @@map("users")
}

//
// ATTENDANCE
//

model Attendance {
  id              String             @id @default(uuid())

  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  tanggal         DateTime

  checkIn         DateTime?
  checkOut        DateTime?

  totalMinutes    Int                @default(0)

  status          AttendanceStatus   @default(PRESENT)
  workMode        WorkMode           @default(ONSITE)

  autoCheckout    Boolean            @default(false)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([userId, tanggal])
  @@index([tanggal])
  @@map("attendances")
}

//
// GEOFENCE LOCATION
//

model AttendanceLocation {
  id            String    @id @default(uuid())

  namaTempat    String

  latitude      Decimal   @db.Decimal(10, 8)
  longitude     Decimal   @db.Decimal(11, 8)

  radiusMeter   Int

  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())

  @@map("attendance_locations")
}

//
// WFH / WFA PERMISSION
//

model WorkPermission {
  id            String            @id @default(uuid())

  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           PermissionType

  startDate      DateTime
  endDate        DateTime

  alasan         String?

  approvedById   String?
  approvedBy     User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  createdAt      DateTime @default(now())

  @@map("work_permissions")
}

//
// LOCATION TRACKING
//

model GeofenceLog {
  id            String   @id @default(uuid())

  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude       Decimal @db.Decimal(10, 8)
  longitude      Decimal @db.Decimal(11, 8)

  insideArea     Boolean

  recordedAt     DateTime @default(now())

  @@index([recordedAt])
  @@map("geofence_logs")
}

//
// DAILY TASK / MISSION
//

model DailyTask {
  id            String   @id @default(uuid())

  title         String
  description   String?

  points        Int      @default(0)

  active        Boolean  @default(true)

  createdAt     DateTime @default(now())

  progress      UserTaskProgress[]

  @@map("daily_tasks")
}

//
// USER TASK PROGRESS
//

model UserTaskProgress {
  id             String   @id @default(uuid())

  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId          String
  task            DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  tanggal         DateTime

  isCompleted     Boolean @default(false)

  completedAt     DateTime?

  @@unique([userId, taskId, tanggal])
  @@map("user_task_progress")
}

//
// WEEKLY SUMMARY (DUOLINGO STYLE)
//

model WeeklySummary {
  id              String   @id @default(uuid())

  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekNumber       Int
  year             Int

  totalHours       Int @default(0)
  totalPresence    Int @default(0)

  streakCount      Int @default(0)

  createdAt        DateTime @default(now())

  @@unique([userId, weekNumber, year])
  @@map("weekly_summaries")
}