generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  nama                String
  email               String             @unique
  password            String
  photo               String?
  role                Role               @default(USER)
  joinDate            DateTime
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  attendances         Attendance[]
  geofenceLogs        GeofenceLog[]
  taskProgress        UserTaskProgress[]
  summaries           WeeklySummary[]
  approvedPermissions WorkPermission[]   @relation("ApprovedBy")
  permissions         WorkPermission[]

  @@map("users")
}

model Attendance {
  id           String           @id @default(uuid())
  userId       String
  tanggal      DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  totalMinutes Int              @default(0)
  status       AttendanceStatus @default(PRESENT)
  workMode     WorkMode         @default(ONSITE)
  autoCheckout Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tanggal])
  @@index([tanggal])
  @@map("attendances")
}

model AttendanceLocation {
  id          String   @id @default(uuid())
  namaTempat  String
  latitude    Decimal  @db.Decimal(10, 8)
  longitude   Decimal  @db.Decimal(11, 8)
  radiusMeter Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("attendance_locations")
}

model WorkPermission {
  id           String         @id @default(uuid())
  userId       String
  type         PermissionType
  startDate    DateTime
  endDate      DateTime
  alasan       String?
  approvedById String?
  createdAt    DateTime       @default(now())
  approvedBy   User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_permissions")
}

model GeofenceLog {
  id         String   @id @default(uuid())
  userId     String
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  insideArea Boolean
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recordedAt])
  @@map("geofence_logs")
}

model DailyTask {
  id          String             @id @default(uuid())
  title       String
  description String?
  points      Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  progress    UserTaskProgress[]

  @@map("daily_tasks")
}

model UserTaskProgress {
  id          String    @id @default(uuid())
  userId      String
  taskId      String
  tanggal     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  task        DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, tanggal])
  @@map("user_task_progress")
}

model WeeklySummary {
  id            String   @id @default(uuid())
  userId        String
  weekNumber    Int
  year          Int
  totalHours    Int      @default(0)
  totalPresence Int      @default(0)
  streakCount   Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber, year])
  @@map("weekly_summaries")
}

enum Role {
  ADMIN
  USER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  PERMISSION
}

enum WorkMode {
  ONSITE
  WFH
  WFA
}

enum PermissionType {
  WFH
  WFA
}
